{
  "expo": {
    "name": "Puriki",
    "slug": "puriki",
    "description": "Anime list manager with on-demand synopsis translation powered by Google Translate.",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "puriki",
    "icon": "./assets/app-icon/puriki-app-icon-1024.png",
    "android": {
      "package": "com.jvitorn.puriki",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon/puriki-adaptive-foreground-1024.png",
        "backgroundColor": "#090C11",
        "monochromeImage": "./assets/app-icon/puriki-monochrome-foreground-1024.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash/puriki-splash-mark-dark-512.png",
          "backgroundColor": "#090C11",
          "resizeMode": "contain",
          "imageWidth": 132
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "pt-BR", "es"],
            "android": ["en", "pt-BR", "es"]
          }
        }
      ],
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f44f7be1-1a8c-4dd6-9753-ee1b626d8406"
      }
    },
    "owner": "jvitorn"
  }
}
