{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "production-apk": {
      "distribution": "internal",
      "developmentClient": false,
      "autoIncrement": false,
      "environment": "production",
      "android": {
        "buildType": "apk",
        "applicationArchivePath": "android/app/build/outputs/apk/release/app-universal-release.apk",
        "buildArtifactPaths": ["android/app/build/outputs/apk/release/*.apk"]
      }
    }
  }
}
